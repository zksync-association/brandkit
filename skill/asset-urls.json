    "brandInline": "{siteMirror}/brand/tokens/brand.inline.css",
    "brandSingleFile": "{siteMirror}/brand.css",
    "tailwindPreset": "{base}/skill/assets/tokens/tailwind.preset.js",
    "tokensJson": "{base}/skill/assets/tokens/tokens.json",
    "officeThemeXml": "{base}/skill/assets/tokens/office-theme-colors.xml"
  },
  "fonts": {
